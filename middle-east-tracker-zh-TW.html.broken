<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>2026 美以伊衝突追蹤 | 地緣政治情報儀表板</title>
    
    <!-- 自动刷新：每小时重新加载页面 -->
    <meta http-equiv="refresh" content="3600">
    
    <style>
        :root {
            --color-bg: #0a0f1e;
            --color-surface: #141b2d;
            --color-surface-elevated: #1a2332;
            --color-border: rgba(99, 102, 241, 0.15);
            --color-border-strong: rgba(99, 102, 241, 0.3);
            --color-text-primary: #e2e8f0;
            --color-text-secondary: #94a3b8;
            --color-text-muted: #64748b;
            --color-accent-primary: #6366f1;
            --color-accent-secondary: #8b5cf6;
            --color-conflict: #ef4444;
            --color-warning: #f59e0b;
            --color-success: #10b981;
            --color-info: #3b82f6;
            --font-display: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
            --font-mono: "SF Mono", Monaco, "Cascadia Code", "Consolas", "Courier New", monospace;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: var(--font-display);
            background: var(--color-bg);
            color: var(--color-text-primary);
            line-height: 1.6;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }
        
        body::before {
            content: '';
            position: fixed;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: 
                radial-gradient(circle at 20% 30%, rgba(99, 102, 241, 0.08) 0%, transparent 40%),
                radial-gradient(circle at 80% 70%, rgba(139, 92, 246, 0.06) 0%, transparent 40%);
            z-index: -1;
            animation: pulse-bg 20s ease-in-out infinite;
        }
        
        @keyframes pulse-bg {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.8; }
        }
        
        .container {
            max-width: 1600px;
            margin: 0 auto;
            padding: 32px 24px;
        }
        
        .header {
            text-align: center;
            margin-bottom: 48px;
            animation: fadeInDown 0.8s ease-out;
        }
        
        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .header h1 {
            font-size: clamp(2rem, 5vw, 3.5rem);
            font-weight: 900;
            letter-spacing: -0.02em;
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #ec4899 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 12px;
        }
        
        .header p {
            font-size: 1.1rem;
            color: var(--color-text-secondary);
            font-weight: 500;
        }
        
        .header .timestamp {
            display: inline-block;
            margin-top: 16px;
            padding: 8px 16px;
            background: var(--color-surface-elevated);
            border: 1px solid var(--color-border);
            border-radius: 24px;
            font-size: 0.875rem;
            font-family: var(--font-mono);
            color: var(--color-accent-primary);
        }
        

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 24px;
            margin-bottom: 48px;
            animation: fadeIn 1s ease-out 0.4s both;
        }
        
        .stat-card {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 16px;
            padding: 28px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }
        
        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, var(--card-accent), transparent);
            opacity: 0;
            transition: opacity 0.3s;
        }
        
        .stat-card:hover {
            border-color: var(--color-border-strong);
            transform: translateY(-4px);
        }
        
        .stat-card:hover::before {
            opacity: 1;
        }
        
        .stat-value {
            font-size: 3rem;
            font-weight: 900;
            line-height: 1;
            margin-bottom: 8px;
            background: linear-gradient(135deg, var(--card-accent), var(--color-accent-secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .stat-label {
            font-size: 0.875rem;
            color: var(--color-text-secondary);
            font-weight: 500;
        }
        
        .stat-meta {
            font-size: 0.75rem;
            color: var(--color-text-muted);
            margin-top: 8px;
            opacity: 0.8;
        }
        
        .stat-change {
            font-size: 0.8125rem;
            font-weight: 600;
            font-family: var(--font-mono);
            margin-left: 6px;
        }
        
        .stat-change.positive {
            color: #10b981;
        }
        
        .stat-change.negative {
            color: #ef4444;
        }
        
        .section {
            margin-bottom: 48px;
        }
        
        .section-title {
            font-size: clamp(1.75rem, 3vw, 2.25rem);
            font-weight: 800;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .section-title-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, var(--section-accent, var(--color-accent-primary)), var(--color-accent-secondary));
            border-radius: 12px;
            font-size: 1.5rem;
        }
        
        .news-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 24px;
            margin-bottom: 48px;
        }
        
        .news-card {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 16px;
            padding: 28px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
        }
        
        .news-card::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(180deg, #ef4444, #dc2626);
            border-radius: 16px 0 0 16px;
            opacity: 0;
            transition: opacity 0.3s;
        }
        
        .news-card:hover {
            border-color: rgba(239, 68, 68, 0.4);
            transform: translateX(4px);
        }
        
        .news-card:hover::before {
            opacity: 1;
        }
        
        .news-source {
            display: inline-block;
            padding: 4px 12px;
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 8px;
            font-size: 0.75rem;
            font-weight: 700;
            color: #fca5a5;
            margin-bottom: 12px;
            font-family: var(--font-mono);
        }
        
        .news-title {
            font-size: 1.125rem;
            font-weight: 700;
            margin-bottom: 12px;
            line-height: 1.4;
        }
        
        .news-description {
            font-size: 0.875rem;
            color: var(--color-text-secondary);
            line-height: 1.6;
            margin-bottom: 12px;
        }
        
        .news-date {
            font-size: 0.75rem;
            color: var(--color-text-muted);
            font-family: var(--font-mono);
        }
        
        .predictions-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 24px;
        }
        
        .prediction-card {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 16px;
            padding: 28px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
        }
        
        .prediction-card::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(180deg, #f59e0b, #d97706);
            border-radius: 16px 0 0 16px;
            opacity: 0;
            transition: opacity 0.3s;
        }
        
        .prediction-card:hover {
            border-color: rgba(245, 158, 11, 0.4);
            transform: translateX(4px);
        }
        
        .prediction-card:hover::before {
            opacity: 1;
        }
        
        .prediction-actor {
            display: inline-block;
            padding: 6px 14px;
            background: rgba(245, 158, 11, 0.15);
            border: 1px solid rgba(245, 158, 11, 0.3);
            border-radius: 8px;
            font-size: 0.813rem;
            font-weight: 700;
            color: #fbbf24;
            margin-bottom: 16px;
        }
        
        .prediction-title {
            font-size: 1.125rem;
            font-weight: 700;
            margin-bottom: 12px;
        }
        
        .prediction-description {
            font-size: 0.875rem;
            color: var(--color-text-secondary);
            line-height: 1.6;
            margin-bottom: 20px;
        }
        
        .probability-bar-container {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid var(--color-border);
        }
        
        .probability-label {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
            font-size: 0.813rem;
            color: var(--color-text-muted);
        }
        
        .probability-value {
            font-weight: 700;
            font-family: var(--font-mono);
            color: #fbbf24;
            font-size: 0.875rem;
        }
        
        .probability-bar {
            height: 8px;
            background: var(--color-surface-elevated);
            border-radius: 8px;
            overflow: hidden;
        }
        
        .probability-fill {
            height: 100%;
            background: linear-gradient(90deg, #f59e0b, #d97706);
            border-radius: 8px;
            transition: width 1.5s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .polymarket-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 24px;
            margin-bottom: 48px;
        }
        
        .polymarket-card {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 16px;
            padding: 28px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
        }
        
        .polymarket-card::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(180deg, #06b6d4, #0891b2);
            border-radius: 16px 0 0 16px;
            opacity: 0;
            transition: opacity 0.3s;
        }
        
        .polymarket-card:hover {
            border-color: rgba(6, 182, 212, 0.4);
            transform: translateX(4px);
        }
        
        .polymarket-card:hover::before {
            opacity: 1;
        }
        
        .polymarket-question {
            font-size: 1.125rem;
            font-weight: 700;
            margin-bottom: 20px;
            line-height: 1.4;
        }
        
        .polymarket-odds {
            display: flex;
            gap: 16px;
            margin: 20px 0;
        }
        
        .odds-option {
            flex: 1;
            background: var(--color-surface-elevated);
            border: 1px solid var(--color-border);
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            transition: all 0.3s;
        }
        
        .odds-option:hover {
            border-color: rgba(6, 182, 212, 0.4);
        }
        
        .odds-label {
            font-size: 0.813rem;
            color: var(--color-text-muted);
            margin-bottom: 8px;
            font-weight: 500;
        }
        
        .odds-value {
            font-size: 2.5rem;
            font-weight: 900;
            background: linear-gradient(135deg, #06b6d4, #0891b2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .polymarket-description {
            font-size: 0.875rem;
            color: var(--color-text-secondary);
            line-height: 1.6;
            margin-bottom: 16px;
        }
        
        .polymarket-volume {
            font-size: 0.813rem;
            color: var(--color-text-muted);
            font-family: var(--font-mono);
        }
        
        .polymarket-volume strong {
            color: #06b6d4;
            font-weight: 600;
        }
        
        /* 市場波動分析樣式 */
        .market-subsection {
            margin-bottom: 48px;
        }
        
        .market-subtitle {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 1.5rem;
            font-weight: 700;
            color: #10b981;
            margin-bottom: 24px;
            padding-bottom: 12px;
            border-bottom: 2px solid rgba(16, 185, 129, 0.2);
        }
        
        .market-icon {
            font-size: 1.75rem;
        }
        
        .market-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 24px;
        }
        
        .market-card {
            background: var(--color-surface);
            border-radius: 16px;
            padding: 24px;
            border: 1px solid var(--color-border);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .market-card:hover {
            transform: translateY(-4px);
            border-color: rgba(16, 185, 129, 0.3);
            box-shadow: 0 8px 24px rgba(16, 185, 129, 0.15);
        }
        
        .oil-card {
            border-left: 4px solid #f59e0b;
        }
        
        .stock-card {
            border-left: 4px solid #3b82f6;
        }
        
        .etf-card {
            border-left: 4px solid #10b981;
        }
        
        .oil-analysis, .stock-analysis {
            grid-column: span 2;
            border-left: 4px solid #10b981;
        }
        
        .market-card-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 12px;
        }
        
        .market-label {
            font-size: 0.875rem;
            color: var(--color-text-muted);
            font-weight: 600;
        }
        
        .market-value {
            font-size: 2rem;
            font-weight: 700;
            font-family: var(--font-mono);
            background: linear-gradient(135deg, #10b981, #06b6d4);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .market-unit {
            font-size: 1rem;
            color: var(--color-text-muted);
            margin-left: 4px;
        }
        
        .market-change {
            font-size: 1.125rem;
            font-weight: 600;
            font-family: var(--font-mono);
            margin-bottom: 16px;
        }
        
        .market-change.positive {
            color: #10b981;
        }
        
        .market-change.negative {
            color: #ef4444;
        }
        
        .market-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.8125rem;
            color: var(--color-text-muted);
            padding-top: 12px;
            border-top: 1px solid var(--color-border);
        }
        
        .market-peak, .market-trend, .market-note, .market-recovery {
            font-weight: 600;
            padding: 4px 8px;
            border-radius: 6px;
            background: rgba(16, 185, 129, 0.1);
            color: #10b981;
        }
        
        .analysis-title {
            font-size: 1.125rem;
            font-weight: 700;
            color: #10b981;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .analysis-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        
        .analysis-list li {
            padding: 12px 0;
            border-bottom: 1px solid var(--color-border);
            line-height: 1.6;
            font-size: 0.9375rem;
        }
        
        .analysis-list li:last-child {
            border-bottom: none;
        }
        
        .positive {
            color: #10b981;
            font-weight: 600;
        }
        
        .sector-winner {
            color: #10b981;
            font-weight: 600;
        }
        
        .sector-loser {
            color: #ef4444;
            font-weight: 600;
        }
        
        /* 市場洞察 */
        .market-insight {
            margin-top: 48px;
            padding: 32px;
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.05), rgba(6, 182, 212, 0.05));
            border-radius: 16px;
            border: 1px solid rgba(16, 185, 129, 0.2);
        }
        
        .insight-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #10b981;
            margin-bottom: 32px;
            text-align: center;
        }
        
        .insight-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 24px;
        }
        
        .insight-card {
            background: rgba(20, 27, 45, 0.6);
            backdrop-filter: blur(12px);
            padding: 24px;
            border-radius: 12px;
            border: 1px solid rgba(16, 185, 129, 0.15);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .insight-card:hover {
            transform: translateY(-4px);
            border-color: rgba(16, 185, 129, 0.4);
            box-shadow: 0 8px 24px rgba(16, 185, 129, 0.2);
        }
        
        .insight-icon {
            font-size: 2rem;
            margin-bottom: 12px;
        }
        
        .insight-label {
            font-size: 1.125rem;
            font-weight: 700;
            color: #10b981;
            margin-bottom: 12px;
        }
        
        .insight-text {
            font-size: 0.9375rem;
            line-height: 1.7;
            color: var(--color-text-secondary);
        }
        
        .insight-text strong {
            color: #10b981;
            font-weight: 600;
        }
        
        .timeline {
            position: relative;
            padding: 40px 0;
        }
        
        .timeline-item {
            position: relative;
            padding-left: 80px;
            padding-bottom: 50px;
            border-left: 2px solid rgba(139, 92, 246, 0.3);
            margin-left: 40px;
        }
        
        .timeline-item:last-child {
            border-left-color: transparent;
        }
        
        .timeline-marker {
            position: absolute;
            left: -12px;
            top: 5px;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: linear-gradient(135deg, #8b5cf6, #3b82f6);
            box-shadow: 0 0 20px rgba(139, 92, 246, 0.6);
            animation: pulse-timeline 2s ease-in-out infinite;
        }
        
        @keyframes pulse-timeline {
            0%, 100% {
                box-shadow: 0 0 20px rgba(139, 92, 246, 0.6);
            }
            50% {
                box-shadow: 0 0 30px rgba(139, 92, 246, 0.9);
            }
        }
        
        .timeline-date {
            background: linear-gradient(135deg, #8b5cf6, #3b82f6);
            color: white;
            display: inline-block;
            padding: 10px 24px;
            border-radius: 20px;
            font-weight: 700;
            margin-bottom: 20px;
            font-size: 1.05em;
            box-shadow: 0 4px 15px rgba(139, 92, 246, 0.3);
        }
        
        .timeline-content {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 16px;
            padding: 30px;
            transition: all 0.3s ease;
        }
        
        .timeline-content:hover {
            border-color: var(--color-border-strong);
            transform: translateX(5px);
        }
        
        .timeline-content h3 {
            color: #f1f5f9;
            margin-bottom: 20px;
            font-size: 1.4em;
            font-weight: 600;
        }
        
        .timeline-content ul {
            list-style: none;
            padding-left: 0;
        }
        
        .timeline-content li {
            padding: 12px 0;
            padding-left: 35px;
            position: relative;
            border-bottom: 1px solid rgba(139, 92, 246, 0.1);
            color: #cbd5e1;
            line-height: 1.7;
        }
        
        .timeline-content li:last-child {
            border-bottom: none;
        }
        
        .timeline-content li:before {
            content: "▸";
            position: absolute;
            left: 12px;
            color: #8b5cf6;
            font-weight: bold;
            font-size: 1.1em;
        }
        
        .highlight {
            background: rgba(139, 92, 246, 0.2);
            color: #c4b5fd;
            padding: 3px 8px;
            border-radius: 6px;
            font-weight: 600;
            border: 1px solid rgba(139, 92, 246, 0.3);
        }
        
        .alert {
            background: rgba(236, 72, 153, 0.2);
            color: #f9a8d4;
            padding: 3px 8px;
            border-radius: 6px;
            font-weight: 600;
            border: 1px solid rgba(236, 72, 153, 0.3);
        }
        
        footer {
            margin-top: 80px;
            padding: 40px 0;
            text-align: center;
            border-top: 1px solid var(--color-border);
        }
        
        footer p {
            font-size: 0.875rem;
            color: var(--color-text-muted);
            line-height: 1.8;
        }
        
        footer strong {
            color: var(--color-accent-primary);
            font-weight: 600;
        }
        
        @media (max-width: 768px) {
            .container {
                padding: 24px 16px;
            }
            
            .header h1 {
                font-size: 2rem;
            }
            
            
            .stats-grid,
            .news-grid,
            .polymarket-grid,
            .predictions-grid,
            .market-grid,
            .insight-grid {
                grid-template-columns: 1fr;
            }
            
            .oil-analysis, .stock-analysis {
                grid-column: span 1;
            }
            
            .market-insight {
                padding: 24px 16px;
            }
            
            .timeline-item {
                padding-left: 50px;
                margin-left: 20px;
            }
        }
        
        ::-webkit-scrollbar {
            width: 10px;
        }
        
        ::-webkit-scrollbar-track {
            background: var(--color-bg);
        }
        
        ::-webkit-scrollbar-thumb {
            background: var(--color-surface-elevated);
            border-radius: 5px;
        }
        
        ::-webkit-scrollbar-thumb:hover {
            background: var(--color-border-strong);
        }
    </style>
</head>
<body>
